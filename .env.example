# Output of db/hash-password.html (or: node db/hash-password.mjs 'password')
ADMIN_PASSWORD_HASH=pbkdf2-sha256$600000$REPLACE_SALT$REPLACE_HASH

# Random string, at least 32 characters. Generate one by running this in your
