# Supabase — public project URL and publishable key (safe for the browser)
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-side only — NEVER expose this in the browser or commit to git
# Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Output of db/hash-password.html (or: node db/hash-password.mjs 'password')
ADMIN_PASSWORD_HASH=pbkdf2-sha256$600000$REPLACE_SALT$REPLACE_HASH

# Random string, at least 32 characters. Generate one by running this in your
# browser console (or any random generator):
#   crypto.getRandomValues(new Uint8Array(32))
# then paste the hex/values here.
SESSION_SECRET=REPLACE_ME_WITH_32_PLUS_RANDOM_CHARS
