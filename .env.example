# Copy to .env (or set these in Vercel) and fill in real values.
# NEVER commit .env — it is gitignored.

# Neon connection string (Project Settings → Connection Details in Neon)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-yyy.region.neon.tech/neondb?sslmode=require

# Output of: node db/hash-password.mjs 'your-password'
ADMIN_PASSWORD_HASH=scrypt$REPLACE_ME$REPLACE_ME

# Random string, at least 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=REPLACE_ME